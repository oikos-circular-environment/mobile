{
  "name": "oikos-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "api",
    "rn",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @oikos/api",
    "build:api": "npm run build -w @oikos/api",
    "lint:api": "npm run lint -w @oikos/api",
    "format:api": "npm run format -w @oikos/api",

    "dev:rn": "npm run start -w @oikos/rn",
    "lint:rn": "npm run lint -w @oikos/rn",
    "format:rn": "npm run format -w @oikos/rn"
  },
  "packageManager": "npm@11.12.0",
  "devDependencies": {
    "@biomejs/biome": "2.4.12"
  }
}
