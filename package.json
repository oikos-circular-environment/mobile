{
	"name": "mobile",
	"main": "expo-router/entry",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"prepare": "lefthook install",
		"postinstall": "patch-package",
		"start": "expo start",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"lint": "biome lint --write --files-ignore-unknown=true .",
		"format": "biome format --write --files-ignore-unknown=true .",
		"db:survey:generate": "drizzle-kit generate",
		"db:oikos-app:generate": "drizzle-kit generate --config drizzle.oikos-app.config.ts",
		"test": "jest --forceExit --maxWorkers=8",
		"test:coverage": "jest --coverage --forceExit --maxWorkers=8",
		"sync:env": "eas env:push production --path .env.eas --force",
		"asc:inspect": "node store/scripts/asc-inspect.mjs",
		"asc:metadata": "eas metadata:push",
		"asc:submit": "node store/scripts/submit-ios-for-review.mjs",
		"play:inspect": "node store/scripts/play-inspect.mjs",
		"play:publish": "node store/scripts/publish-android-release.mjs"
	},
