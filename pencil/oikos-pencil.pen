                              "type": "text",
                              "id": "fnbwl",
                              "fill": "$foreground",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Você pode pausar, retomar ou desistir a qualquer momento, sem nenhuma penalidade. Desistir não exclui dados já enviados, mas você pode pedir a exclusão depois usando o código de participante.",
                              "lineHeight": 1.5,
                              "fontFamily": "$font-body",
                              "fontSize": "$text-body-sm",
                              "fontWeight": "normal"
