                              "type": "text",
                              "id": "L9ISZ",
                              "fill": "$foreground",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Participar desta pesquisa encerra a sessão da sua conta atual no aplicativo. A pesquisa é conduzida como visitante, e você pode voltar à sua conta normalmente ao final.",
                              "lineHeight": 1.5,
                              "fontFamily": "$font-body",
                              "fontSize": "$text-body-sm",
                              "fontWeight": "normal"
                            },
